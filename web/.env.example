# Parchment — optional integrations. Copy this file to `.env.local` for local dev,
# and add the same keys in Vercel → Project → Settings → Environment Variables.
# Both are NEXT_PUBLIC_* because they're used in the browser (safe to expose).
# The app works fully local-first with neither of these set.

# Dexie Cloud sync (multi-device). Create a database with `npx dexie-cloud create`
# (run inside web/); it prints a databaseUrl like https://xxxxxxxx.dexie.cloud.
# Paste that URL here. Users then sign in from the "Sign in to sync" panel in the
# nav footer (email one-time code) — there is no password to configure.
NEXT_PUBLIC_DEXIE_CLOUD_URL=

# OpenWeatherMap key — enables the map's "Temp" radar layer. Get a free key at
# https://openweathermap.org/api (the free tier includes the weather map tiles).
NEXT_PUBLIC_OWM_API_KEY=
