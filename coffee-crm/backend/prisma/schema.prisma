generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ContactType {
  client
  supplier
  both
}

enum Tier {
  A
  B
  C
  prospect
}

enum LeadStatus {
  cold
  contacted
  sample_sent
  negotiating
  customer
  dormant
  churned
}

enum ActivityType {
  call
  meeting
  note
  status_change
  next_action
}

enum PriceMarket {
  robusta
  arabica
  usd_index
}

enum Channel {
  whatsapp
  email
}

enum MessageDirection {
  in
  out
}

enum DealStage {
  lead
  engaged
  sample_sent
  sample_feedback
  negotiation
  contracted
  shipped
  closed_won
  closed_lost
}

// §10/§12 of DESIGN.md: a deal can be priced outright (a flat price per unit)
// or as a differential against the C-market (cents/lb over/under the latest
// PriceQuote for the chosen market). Both currencies are first-class, not
// just EUR with a USD afterthought.
enum PriceType {
  outright
  differential
}

enum DealCurrency {
  EUR
  USD
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  role         String   @default("owner")
  createdAt    DateTime @default(now())
}

model Contact {
  id                   String      @id @default(uuid())
  type                 ContactType
  name                 String
  company              String?
  country              String?
  region               String?
  emails               String[]
  phones               String[]
  whatsappEnabledPhone String?
  tier                 Tier?
  leadStatus           LeadStatus?
  source               String?
  preferredCurrency    String?
  incotermDefault      String?
  notes                String?
  businessCardImageUrl String?
  createdAt            DateTime    @default(now())
  lastContactedAt      DateTime?
  activities           Activity[]
  conversations        Conversation[]
  deals                Deal[]

  @@index([company])
}

model Deal {
  id                String       @id @default(uuid())
  contactId         String
  contact           Contact      @relation(fields: [contactId], references: [id], onDelete: Cascade)
  coffeeDescription String?
  stage             DealStage    @default(lead)

  priceType         PriceType
  currency          DealCurrency
  // outright: flat price per lb in `currency`.
  outrightPrice     Float?
  // differential: cents per lb over(+)/under(-) the latest PriceQuote for `market`.
  market            PriceMarket?
  differentialCents Float?

  quantityKg        Float?
  incoterm          String?
  expectedCloseDate DateTime?
  probability       Int?
  lostReason        String?

  createdAt         DateTime  @default(now())
  closedAt          DateTime?
}

model Conversation {
  id            String    @id @default(uuid())
  contactId     String
  contact       Contact   @relation(fields: [contactId], references: [id], onDelete: Cascade)
  channel       Channel
  subject       String?
  lastMessageAt DateTime?
  messages      Message[]
}

model Message {
  id             String           @id @default(uuid())
  conversationId String
  conversation   Conversation     @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  direction      MessageDirection
  channel        Channel
  body           String
  mediaUrls      String[]
  sentAt         DateTime         @default(now())
  externalId     String?          @unique
}

model Activity {
  id        String       @id @default(uuid())
  contactId String
  contact   Contact      @relation(fields: [contactId], references: [id], onDelete: Cascade)
  type      ActivityType
  body      String
  dueAt     DateTime?
  createdAt DateTime     @default(now())
}

model PriceQuote {
  id            String      @id @default(uuid())
  market        PriceMarket
  contractMonth String?
  price         Float
  currency      String
  quoteDate     DateTime
  source        String
  isDelayed     Boolean     @default(true)
  createdAt     DateTime    @default(now())

  @@unique([market, contractMonth, quoteDate])
}
