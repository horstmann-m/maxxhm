DATABASE_URL="postgresql://postgres:postgres@localhost:5432/coffee_crm"
PORT=3000

# Auth (§15) — required, the server refuses to start without it. Generate with
# `openssl rand -base64 48`. Every route except /health, /auth/login, and the
# Twilio webhook requires a valid JWT signed with this secret.
JWT_SECRET=

# One-time owner account bootstrap: OWNER_EMAIL=you@example.com OWNER_PASSWORD=... npm run create-owner
OWNER_EMAIL=
OWNER_PASSWORD=

# Mistral (EU-hosted) vision for business-card OCR (§11)
MISTRAL_API_KEY=
MISTRAL_MODEL=pixtral-large-latest

# Twilio WhatsApp (§3) — sandbox number for testing, e.g. whatsapp:+14155238886
# Accepted exception to the EU-only infra policy (§14) since WhatsApp is
# inherently Meta-routed and dropping it was ruled out as a requirement.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_NUMBER=
