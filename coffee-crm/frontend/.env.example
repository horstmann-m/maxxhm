# Server-side only — the Next.js server (page renders + /api/* route
# handlers) talks to the backend directly using this. Never exposed to the
# browser, unlike NEXT_PUBLIC_* vars.
BACKEND_URL=http://localhost:3000

# Legacy/fallback if BACKEND_URL isn't set — kept for local dev convenience,
# but since client components no longer call the backend directly (they go
# through /api/* so the httpOnly session cookie is used), this is only a
# fallback for BACKEND_URL now, not a client-facing URL.
NEXT_PUBLIC_API_URL=http://localhost:3000
